# =========================================================
# LabFlow Backend — Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs
# =========================================================

# ── Serveur ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Base de données PostgreSQL ───────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fiche_technique
DB_USER=postgres
DB_PASSWORD=votre_mot_de_passe
DB_SSL=false

# ── Authentification JWT ─────────────────────────────────
# Générer : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=changez_moi_en_production

# ── Email (Resend) ───────────────────────────────────────
# Compte gratuit sur resend.com → API Keys → Create API Key
RESEND_API_KEY=re_xxxxxxxxxxxx
FROM_EMAIL=noreply@votredomaine.com

# ── Application ──────────────────────────────────────────
APP_URL=http://localhost:5173
# Adresse des écrans de LabFlow Compta (production : https://compta.labflow-tn.com). Sans elle, les liens des emails
# de LabFlow Compta pointent sur APP_URL.
APP_URL_COMPTA=http://localhost:5174
APP_NAME=LabFlow

# ── Agent IA — Gemini (moteur UNIQUE depuis 2026-07-24) ──
# aistudio.google.com → Get API key. Projet AVEC facturation recommandé
# (les données ne servent pas à l'entraînement, cf. loi 2004-63).
GEMINI_API_KEY=
# Modèle (optionnel) — défaut gemini-flash-latest ; TOUJOURS un alias, les modèles
# datés (gemini-2.5-flash…) sont retirés pour les nouvelles clés.
GEMINI_MODEL=

# ── Agent IA — Messenger (Facebook Page) ─────────────────
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_VERIFY_TOKEN=
MESSENGER_PAGE_USERNAME=
# App Secret de l'app Meta — ACTIVE la vérification de signature X-Hub-Signature-256
# du webhook Messenger (recommandé). Tant qu'il est vide, le webhook n'est PAS authentifié.
MESSENGER_APP_SECRET=

# ── Identité légale du prestataire (factures) ───────────
# Mentions portées sur les factures (docuseal-templates/generate.js : bloc « parties » et pied légal).
# OBLIGATOIRE en prod : sans elles, les factures sortent avec des valeurs d'exemple.
FACTURE_PRESTATAIRE_NOM=            # nom commercial, ex. LabFlow
FACTURE_ADRESSE=                    # siège social complet
FACTURE_MATRICULE_FISCAL=           # matricule fiscal, ex. 1234567/A/M/000 — auto-entrepreneur : identifiant unique, ex. 1996459A
FACTURE_TVA_RATE=19
PRESTATAIRE_FORME=                  # forme juridique, ex. SARL / SUARL / Auto-entrepreneur
PRESTATAIRE_RAISON_SOCIALE=         # défaut : "<NOM> <FORME>" — auto-entrepreneur : nom et prénom du titulaire
PRESTATAIRE_RC=                     # n° RNE/RC — auto-entrepreneur : DÉFINIR VIDE (= aucun ; absent = valeur d'exemple)
PRESTATAIRE_CAPITAL=                # ex. 10 000 DT — auto-entrepreneur : DÉFINIR VIDE (= aucun)
PRESTATAIRE_EMAIL=
PRESTATAIRE_TEL=

# ── Tuning du pool PostgreSQL (optionnel) ────────────────
# max ≈ (max_connections Postgres) / (nb d'instances). Défauts: 15 / 30s / 5s / 30s.
DB_POOL_MAX=15
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=30000

# ── Observabilité (optionnel) ────────────────────────────
# Si défini, branchez Sentry (à installer séparément). Laissé vide = logs structurés JSON seuls.
SENTRY_DSN=
